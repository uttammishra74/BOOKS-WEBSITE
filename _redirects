# Cloudflare Pages Redirects Configuration
# https://developers.cloudflare.com/pages/platform/redirects/

# Force redirect from preview domains to production domain
# This prevents access to .pages.dev preview URLs
https://*.pages.dev/* https://freebookleaf.online/:splat 301

# Handle 404 errors by redirecting to custom 404 page
/errors/404.html /404 404
/errors/500.html /500 500